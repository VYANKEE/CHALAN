# Copy to .env and adjust if needed. .env itself is gitignored - never commit it.

DATABASE_URL=postgresql+psycopg2://invoice:invoice@localhost:5432/invoice
REDIS_URL=redis://localhost:6379/0

UPLOAD_DIR=data/uploads
SAMPLE_DATA_DIR=data/samples

# pytorch_gpu | pytorch_cpu | onnx_int8 | dummy (dummy = no real model, for quick smoke tests)
INFERENCE_BACKEND=pytorch_gpu
LORA_ADAPTER_DIR=models/lora_combined_v1
ONNX_INT8_PATH=models/onnx/model_int8.onnx

MAX_UPLOAD_MB=10
